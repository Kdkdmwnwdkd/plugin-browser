<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 下载目录：应用外部私有目录 -->
    <external-files-path
        name="app_downloads"
        path="Download/" />
    <!-- 应用内更新下载的安装包（外部缓存优先，回退内部缓存） -->
    <external-cache-path
        name="update_external_cache"
        path="." />
    <cache-path
        name="update_cache"
        path="." />
    <!-- API 28 及以下的公共下载目录（旧版存储） -->
    <external-path
        name="public_downloads"
        path="Download/" />
</paths>
