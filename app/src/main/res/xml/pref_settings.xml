<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_search_engine">

        <ListPreference
            android:defaultValue="baidu"
            android:entries="@array/search_engine_entries"
            android:entryValues="@array/search_engine_values"
            android:key="search_engine"
            android:title="@string/settings_search_engine"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="file:///android_asset/home.html"
            android:key="home_url"
            android:title="@string/settings_home_url"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="浏览">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="javascript"
            android:title="@string/settings_javascript" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="third_party_cookies"
            android:title="@string/settings_third_party_cookies" />

        <ListPreference
            android:defaultValue="default"
            android:entries="@array/ua_preset_entries"
            android:entryValues="@array/ua_preset_values"
            android:key="ua_preset"
            android:summary="部分站点只对特定浏览器提供下载直链，可切换试试（重开页面生效）"
            android:title="浏览器标识"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="block_ads"
            android:title="@string/settings_block_ads" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="desktop_ua"
            android:title="@string/settings_desktop_ua" />

        <Preference
            android:key="plugin_store"
            android:summary="@string/settings_plugins_summary"
            android:title="@string/settings_plugins" />

        <Preference
            android:key="gesture_settings"
            android:summary="@string/settings_gesture_summary"
            android:title="@string/settings_gesture_title" />

        <Preference
            android:key="translate_service"
            android:summary="@string/settings_translate_summary"
            android:title="@string/settings_translate" />
    </PreferenceCategory>

    <PreferenceCategory android:title="网络">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="github_accel"
            android:summary="GitHub 相关域名走独立通道：自定义 DNS、可选代理、磁盘缓存。页面和图片都覆盖，出问题可以关掉"
            android:title="GitHub 加速" />

        <EditTextPreference
            android:key="proxy_url"
            android:title="代理服务器"
            app:useSimpleSummaryProvider="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="doh_enabled"
            android:summary="raw、camo、avatars 这些域名在国内常被 DNS 污染，改用 HTTPS 查询绕开"
            android:title="DoH 解析" />

        <Preference
            android:key="net_probe"
            android:summary="点一下看 GitHub 现在的连通性和耗时"
            android:title="测试连接" />
    </PreferenceCategory>

    <PreferenceCategory android:title="外观">

        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="theme"
            android:title="@string/settings_theme"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="数据">

        <Preference
            android:key="clear_data"
            android:summary="@string/settings_clear_data_summary"
            android:title="@string/settings_clear_data" />
    </PreferenceCategory>

    <PreferenceCategory android:title="关于">

        <Preference
            android:key="check_update"
            android:title="@string/update_check_title"
            android:summary="@string/update_check_summary" />

    <PreferenceCategory android:title="@string/backup_title">

        <Preference
            android:key="backup_export"
            android:summary="@string/backup_export_summary"
            android:title="@string/backup_export" />

        <Preference
            android:key="backup_import"
            android:summary="@string/backup_import_summary"
            android:title="@string/backup_import" />

    </PreferenceCategory>

        <Preference
            android:key="about"
            android:summary="@string/settings_about_summary"
            android:title="@string/settings_about" />
    </PreferenceCategory>
</PreferenceScreen>
