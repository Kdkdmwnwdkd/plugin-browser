<?xml version="1.0" encoding="utf-8"?>
<!--
  备份规则（Android 12+）。
  浏览历史、Cookie、插件存储都属于隐私数据，不参与云备份/设备迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pb_settings.xml" />
        <exclude domain="sharedpref" path="pb_plugin_states.xml" />
        <exclude domain="sharedpref" path="pb_plugin_data_" />
        <exclude domain="sharedpref" path="pb_session.xml" />
        <exclude domain="database" path="browser.db" />
        <exclude domain="file" path="plugins/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pb_settings.xml" />
        <exclude domain="sharedpref" path="pb_plugin_states.xml" />
        <exclude domain="sharedpref" path="pb_plugin_data_" />
        <exclude domain="sharedpref" path="pb_session.xml" />
        <exclude domain="database" path="browser.db" />
        <exclude domain="file" path="plugins/" />
    </device-transfer>
</data-extraction-rules>
