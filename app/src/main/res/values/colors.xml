<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material3 颜色角色（浅色）。

      这套色板只做两件事：中性灰分层 + 单一冷调强调色。
      之前只覆盖了 15 个角色，缺 colorSurfaceContainer* 系列 —— Material3 的菜单、
      对话框、卡片、Chip 默认读的就是这些，缺一个就回落到框架自带的紫调中性色，
      于是「中性灰界面里混进一块米紫面板」，观感非常像拼装出来的。
    -->

    <!-- 强调色：只用于交互（进度、选中、链接），不做大面积填充 -->
    <color name="colorPrimary">#1E4FD8</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorPrimaryContainer">#DCE3FF</color>
    <color name="colorOnPrimaryContainer">#0A1740</color>

    <color name="colorSecondary">#52596B</color>
    <color name="colorOnSecondary">#FFFFFF</color>
    <color name="colorSecondaryContainer">#E4E7EF</color>
    <color name="colorOnSecondaryContainer">#171B24</color>

    <color name="colorTertiary">#3A6376</color>
    <color name="colorOnTertiary">#FFFFFF</color>
    <color name="colorTertiaryContainer">#BEE3F5</color>
    <color name="colorOnTertiaryContainer">#001F2A</color>

    <!-- 表面层级：从「和页面同色」到「明显抬起」，全部中性灰 -->
    <color name="colorSurface">#FAFAFA</color>
    <color name="colorSurfaceDim">#DCDCE0</color>
    <color name="colorSurfaceBright">#FAFAFA</color>
    <color name="colorSurfaceContainerLowest">#FFFFFF</color>
    <color name="colorSurfaceContainerLow">#F5F5F7</color>
    <color name="colorSurfaceContainer">#EFEFF2</color>
    <color name="colorSurfaceContainerHigh">#E9E9ED</color>
    <color name="colorSurfaceContainerHighest">#E3E3E8</color>
    <color name="colorSurfaceVariant">#EDEDF1</color>
    <color name="colorOnSurface">#17181B</color>
    <color name="colorOnSurfaceVariant">#71757F</color>
    <color name="colorOutline">#8A8B94</color>
    <color name="colorOutlineVariant">#E7E8EB</color>

    <color name="colorInverseSurface">#2E3034</color>
    <color name="colorInverseOnSurface">#F1F1F4</color>
    <color name="colorInversePrimary">#B7C4FF</color>

    <color name="colorError">#B3261E</color>
    <color name="colorOnError">#FFFFFF</color>
    <color name="colorErrorContainer">#F9DEDC</color>
    <color name="colorOnErrorContainer">#410E0B</color>
    <color name="colorScrim">#000000</color>

    <!-- 浏览器 UI 专用 -->
    <color name="pb_progress">#1E4FD8</color>
    <!-- 无痕标识：这套界面只有一支蓝，紫色是唯一一个「不属于任何规则」的颜色，收成墨灰 -->
    <color name="pb_incognito">#4A4E58</color>
    <color name="pb_thumbnail_bg">#E9E9ED</color>
    <color name="pb_scrim">#99000000</color>
    <!-- 强调色的低透明度填充（导入按钮、选中背景） -->
    <color name="pb_accent_soft">#141E4FD8</color>
    <!-- 小徽标描边 -->
    <color name="pb_tag_border">#2617181C</color>
    <!-- 列表行分隔线，比 outlineVariant 更淡 -->
    <color name="pb_divider">#0F17181C</color>
    <!-- 工具栏图标的禁用态 -->
    <color name="pb_icon_disabled">#C4C5CC</color>
</resources>
