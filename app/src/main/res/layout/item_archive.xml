<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PluginBrowser.ListRow">

    <ImageView
        android:id="@+id/archive_icon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:layout_marginEnd="@dimen/space_12"
        android:contentDescription="@string/bookmarks_title"
        android:src="@drawable/ic_bookmark_border"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/archive_title"
            style="@style/Widget.PluginBrowser.ListRowTitle" />

        <TextView
            android:id="@+id/archive_url"
            style="@style/Widget.PluginBrowser.ListRowMeta" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_4"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/archive_clear"
        android:padding="@dimen/space_8"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
