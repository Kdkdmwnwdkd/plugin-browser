<?xml version="1.0" encoding="utf-8"?>
<!--
  标签行：横向一条，不是卡片。

  原来每张标签是一个 96dp 缩略图的大卡，两列排下来一屏只能看见 4 个，
  标签一多就要滚很久，还看不出「我到底开了几个」。改成 76dp 的列表行：
  一张 44dp 的缩略图当色块提示，标题和域名各一行，当前标签用左边
  2.5dp 的竖条标出来。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tab_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_row_height"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/space_4">

        <!-- 当前标签：贴左的一条竖线，不是整卡描边 -->
        <View
            android:id="@+id/tab_active_bar"
            android:layout_width="2.5dp"
            android:layout_height="44dp"
            android:background="?attr/colorPrimary"
            android:visibility="invisible" />

        <FrameLayout
            android:layout_width="@dimen/tab_thumb_size"
            android:layout_height="@dimen/tab_thumb_size"
            android:layout_marginStart="14dp"
            android:background="@color/pb_thumbnail_bg">

            <ImageView
                android:id="@+id/tab_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tabs_title"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tab_title"
                style="@style/Widget.PluginBrowser.ListRowTitle"
                android:layout_height="wrap_content"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_incognito_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_incognito_badge"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="1dp"
                    android:text="@string/incognito_badge"
                    android:textColor="@color/pb_incognito"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tab_url"
                    style="@style/Widget.PluginBrowser.ListRowMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_tab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="@dimen/screen_margin"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>
