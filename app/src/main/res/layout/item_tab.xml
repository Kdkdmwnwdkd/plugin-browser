<?xml version="1.0" encoding="utf-8"?>
<!-- 标签卡片：缩略图 + 域名信息，当前标签用细描边标记（由适配器切换 strokeColor） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="?attr/colorSurfaceContainerHigh">

            <ImageView
                android:id="@+id/tab_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tabs_title"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tab_incognito_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_8"
                android:background="@drawable/bg_incognito_badge"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/incognito_badge"
                android:textColor="@color/pb_incognito"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />

            <!--
              底是 40% 黑，图标必须是白色。原来 tint 取了 colorOnSurface，
              浅色模式下就是近黑压近黑，这个按钮在白云上基本看不见。
            -->
            <ImageButton
                android:id="@+id/btn_close_tab"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_8"
                android:background="@drawable/bg_close_tab"
                android:contentDescription="@string/cancel"
                android:padding="@dimen/space_4"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_12">

            <TextView
                android:id="@+id/tab_title"
                style="@style/Widget.PluginBrowser.ListRowTitle"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tab_url"
                style="@style/Widget.PluginBrowser.ListRowMeta"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
