<?xml version="1.0" encoding="utf-8"?>
<!-- 标签卡片：缩略图 + 域名信息，当前标签用细描边标记（由适配器切换 strokeColor） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:background="@color/pb_thumbnail_bg">

            <ImageView
                android:id="@+id/tab_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tabs_title"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tab_incognito_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_incognito_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/incognito_badge"
                android:textColor="@color/pb_incognito"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_close_tab"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_close_tab"
                android:contentDescription="@string/cancel"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tab_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tab_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
