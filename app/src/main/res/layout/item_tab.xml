<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp">

        <ImageView
            android:id="@+id/tab_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pb_thumbnail_bg"
            android:contentDescription="@string/tabs_title"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@color/pb_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tab_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="#DDFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tab_incognito_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_incognito_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/incognito_badge"
            android:textColor="@color/pb_incognito"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_close_tab"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_close_tab"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
