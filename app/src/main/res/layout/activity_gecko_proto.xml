<?xml version="1.0" encoding="utf-8"?>
<!--
  GeckoView 原型页。刻意只用一个工具栏 + 一块画布，
  跟主线那套「通栏地址栏 + 底栏」的视觉无关——它现在的任务是证明内核能用，
  不是好看。等能用了再把 2.10 的那套版式搬过来。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/geo_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.3"
            android:gravity="center"
            android:text="←"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/geo_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.3"
            android:gravity="center"
            android:text="→"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/geo_address"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="搜索或输入网址"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/geo_reload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <ProgressBar
        android:id="@+id/geo_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="?attr/colorPrimary"
        android:visibility="gone" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geo_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/geo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/geo_engine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="?attr/colorOutline"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
