<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PluginBrowser.ListRow">

    <TextView
        android:id="@+id/res_kind"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/bg_icon_tile"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/res_name"
            style="@style/Widget.PluginBrowser.ListRowTitle"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/res_meta"
            style="@style/Widget.PluginBrowser.ListRowMeta" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/res_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_4"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sniffer_download"
        android:padding="@dimen/space_8"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_download"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
