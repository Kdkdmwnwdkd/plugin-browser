<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.PluginBrowser.GroupLabel"
        android:text="@string/menu_group_page" />

    <LinearLayout
        android:id="@+id/row_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.PluginBrowser.GroupLabel"
        android:text="@string/menu_group_tabs" />

    <LinearLayout
        android:id="@+id/row_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.PluginBrowser.GroupLabel"
        android:text="@string/menu_group_tools" />

    <LinearLayout
        android:id="@+id/row_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/title_plugins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.PluginBrowser.GroupLabel"
        android:text="@string/menu_group_plugins"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row_plugins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/row_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
