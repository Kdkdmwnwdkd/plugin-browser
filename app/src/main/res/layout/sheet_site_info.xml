<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 站点身份 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/site_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/site_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/site_cert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            style="@style/SiteSheetSection"
            android:text="这个网站的设置" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_desktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="桌面版网页"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文字大小"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/zoom_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/zoom_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_js"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="允许运行 JavaScript"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="关掉后页面可能显示不全，只在必要时关"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="加载图片"
            android:textSize="14sp" />

        <TextView
            style="@style/SiteSheetSection"
            android:text="权限" />

        <LinearLayout
            android:id="@+id/perm_camera"
            style="@style/SiteSheetRow">

            <TextView
                style="@style/SiteSheetRowTitle"
                android:text="相机" />

            <TextView
                android:id="@+id/perm_camera_value"
                style="@style/SiteSheetRowValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/perm_mic"
            style="@style/SiteSheetRow">

            <TextView
                style="@style/SiteSheetRowTitle"
                android:text="麦克风" />

            <TextView
                android:id="@+id/perm_mic_value"
                style="@style/SiteSheetRowValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/perm_location"
            style="@style/SiteSheetRow">

            <TextView
                style="@style/SiteSheetRowTitle"
                android:text="位置" />

            <TextView
                android:id="@+id/perm_location_value"
                style="@style/SiteSheetRowValue" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="2dp"
            android:paddingEnd="24dp"
            android:text="点一下切换：询问 / 允许 / 拒绝"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            style="@style/SiteSheetSection"
            android:text="内容过滤" />

        <LinearLayout
            android:id="@+id/row_blocked"
            style="@style/SiteSheetRow">

            <TextView
                style="@style/SiteSheetRowTitle"
                android:text="已屏蔽的元素" />

            <TextView
                android:id="@+id/blocked_value"
                style="@style/SiteSheetRowValue" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="菜单 → 屏蔽页面元素，点一下就能隐藏广告位；点上面这行可全部恢复"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_site"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="清除本站数据"
            android:textColor="?attr/colorError" />
    </LinearLayout>
</ScrollView>
