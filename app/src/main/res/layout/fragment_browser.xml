<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- 加载进度：细线，圆角，靠 scaleX 插值推进 -->
    <View
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@drawable/bg_progress_bar"
        android:scaleX="0"
        android:transformPivotX="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 地址栏：胶囊容器，只保留站点信息与刷新；菜单统一收在底栏 -->
    <LinearLayout
        android:id="@+id/address_bar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar">

        <LinearLayout
            android:id="@+id/address_pill"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_address_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/security_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/security_https"
                android:src="@drawable/ic_lock"
                app:tint="?attr/colorOnSurfaceVariant" />

            <AutoCompleteTextView
                android:id="@+id/address_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:completionThreshold="1"
                android:hint="@string/address_bar_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="0dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incognito_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_incognito_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/incognito_badge"
                android:textColor="@color/pb_incognito"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_refresh"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- 页内查找栏：默认隐藏，只在需要时占位 -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_bar_row"
        tools:visibility="visible">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp" />

        <ImageButton
            android:id="@+id/find_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_prev"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_up"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/find_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_next"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/find_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- WebView 容器：所有标签页的 WebView 在此切换 -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bar_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/find_bar" />

    <View
        android:id="@+id/bar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 底部工具栏：五个高频动作，标签数用方框计数 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="@string/menu_refresh"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="@string/menu_refresh"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_forward"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="@string/menu_home"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home"
            app:tint="?attr/colorOnSurface" />

        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tab_count_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_counter"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="@string/menu_settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
