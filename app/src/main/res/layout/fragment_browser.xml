<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- 加载进度：细线，圆角，靠 scaleX 插值推进 -->
    <View
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@drawable/bg_progress_bar"
        android:elevation="8dp"
        android:outlineProvider="none"
        android:scaleX="0"
        android:transformPivotX="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      地址栏：一条通栏的带子，不是胶囊。

      左边从 24dp 起，和下面的正文、上面的标题对齐到同一条基线；右边收到 4dp，
      因为刷新按钮自己带 12dp 内边距。只在下面留一条 1dp 线 —— 上面顶着状态栏，
      再加一条线就是画面里唯一一条没有分界作用的线。
    -->
    <LinearLayout
        android:id="@+id/address_bar_row"
        android:layout_width="0dp"
        android:layout_height="@dimen/address_bar_height"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar">

        <ImageView
            android:id="@+id/security_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="@dimen/space_8"
            android:contentDescription="@string/security_https"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorOnSurfaceVariant" />

        <AutoCompleteTextView
            android:id="@+id/address_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:completionThreshold="1"
            android:hint="@string/address_bar_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_8"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/incognito_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:background="@drawable/bg_incognito_badge"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/incognito_badge"
            android:textColor="@color/pb_incognito"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_refresh"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:id="@+id/address_bottom_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_bar_row" />

    <!-- 页内查找栏：默认隐藏，只在需要时占位 -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/space_4"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_bar_row"
        tools:visibility="visible">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_4"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

        <ImageButton
            android:id="@+id/find_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_prev"
            android:padding="@dimen/space_8"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_up"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/find_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_next"
            android:padding="@dimen/space_8"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/find_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_close"
            android:padding="@dimen/space_8"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!--
      WebView 容器：所有标签页的 WebView 在此切换。
      外面套一层下拉刷新，是为了拿到「网页是否已经到顶」——
      WebView 的内部滚动在 View 层看不见，只能用宿主上报的真实位置判断。
    -->
    <com.pluginbrowser.browser.PullToRefreshLayout
        android:id="@+id/web_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bar_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/find_bar" />

    <View
        android:id="@+id/bar_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 刚跳去过外部 App 又回来了：给一条能一键再打开的提示，别让人自己找 -->
    <LinearLayout
        android:id="@+id/handoff_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/space_4"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/handoff_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/handoff_reopen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="再打开"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/handoff_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭提示"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!--
      底部工具栏：五个等宽动作，高 52dp。

      不加阴影，靠上面那条 1dp 细线和内容分开 —— 阴影压在白色网页上会显出一条灰带。
      标签数是图标右上角的一小块，而不是一个居中的大圆：居中会把它变成底栏里最显眼的
      东西，而它其实只是「现在有几个标签」这种随手可查的状态。
    -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bar_height"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_forward"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_forward"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_home"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home"
            app:tint="?attr/colorOnSurface" />

        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/tabs_title"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tabs"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tab_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tab_count_badge"
                android:layout_gravity="center"
                android:layout_marginStart="9dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tab_counter"
                android:gravity="center"
                android:minWidth="@dimen/tab_count_badge"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="1"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_settings"
            android:padding="@dimen/space_12"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
