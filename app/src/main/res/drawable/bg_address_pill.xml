<?xml version="1.0" encoding="utf-8"?>
<!--
  地址栏胶囊。

  原来用 surfaceVariant（#F2F2F5）配 1dp 描边、14dp 圆角：在 #FAFAFA 的页面上
  这块填充几乎看不见，剩下那圈描边就成了一个「空框」，看着像没加载完的输入框。
  改成容器色填充、去掉描边、圆角取高度的一半（48/2），才是真正的胶囊。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
