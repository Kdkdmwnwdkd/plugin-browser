<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 风筝左翼：受光面，从纸白过渡到强调蓝 -->
    <path android:pathData="M54.01,24.39 L31.75,48.25 L54.01,63.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="31.75" android:startY="48.25"
                android:endX="54.01" android:endY="63.7">
                <item android:offset="0" android:color="#FFDCE4FF" />
                <item android:offset="0.5" android:color="#FF93ABFF" />
                <item android:offset="1" android:color="#FF4A65E4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 风筝右翼：背光面，压深做出折纸的厚度 -->
    <path android:pathData="M55.19,24.39 L77.45,48.25 L55.19,63.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="77.45" android:startY="48.25"
                android:endX="55.19" android:endY="63.7">
                <item android:offset="0" android:color="#FF4157D2" />
                <item android:offset="1" android:color="#FF141A55" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 尾线：一线牵着，轻但不飘 -->
    <path
        android:pathData="M54.6,62.95 C54.77,67.82 50.57,70.34 52.08,75.97 C53.09,79.16 51.24,80.84 50.57,82.69"
        android:strokeColor="#FFAFC0FF"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
